# Токен бота от @BotFather
BOT_TOKEN=123456:ABC...

# Мастер-ключ шифрования базы (логины, пароли, токены, оценки). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_KEY=

# Прокси только для Telegram (Moodle идёт напрямую), например socks5://127.0.0.1:1080
# Пусто — без прокси.
TELEGRAM_PROXY=

MOODLE_URL=https://edu.mmcs.sfedu.ru
DB_PATH=botik.sqlite3
TIMEZONE=Europe/Moscow

# Раз в сколько часов автоматически проверять каждого пользователя.
# Проверки размазаны по времени: каждые 5 минут — небольшая порция людей.
POLL_HOURS=6

# /check и обновление в /week — не чаще, чем раз в столько часов (после любой проверки).
# В это время /week отвечает из базы.
CHECK_COOLDOWN_HOURS=3

# Еженедельный дайджест: день (mon..sun) и час
DIGEST_DAY=mon
DIGEST_HOUR=9

# Во сколько утром присылать "сегодня дедлайн"
REMIND_HOUR=9
